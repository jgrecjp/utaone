# Shared storage
UTAONE_ROOT=/app
UTAONE_DATABASE_PATH=/data/utaone.sqlite3
UTAONE_STORAGE_PATH=/data/media
UTAONE_ADMIN_API_TOKEN=replace-with-a-long-random-value
UTAONE_API_URL=http://api:8000

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_AUDIO_MODEL=gemini-3.6-flash

# RevenueCat (server only)
REVENUECAT_ENTITLEMENT_ID=premium
UTAONE_REQUIRE_SUBSCRIPTION=false
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace-with-random-webhook-token
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# Laravel
APP_NAME=UtaOne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
DB_CONNECTION=sqlite

# Flutter values are passed with --dart-define and are not read from this file.
# Only RevenueCat public SDK keys belong in the mobile build.
