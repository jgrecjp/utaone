UTAONE_ROOT=/var/www/utaone
UTAONE_DATABASE_PATH=/var/lib/utaone/utaone.sqlite3
UTAONE_STORAGE_PATH=/var/lib/utaone/media
UTAONE_ADMIN_API_TOKEN=replace-with-a-long-random-value

FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_AUDIO_MODEL=gemini-3.6-flash

REVENUECAT_ENTITLEMENT_ID=premium
UTAONE_REQUIRE_SUBSCRIPTION=true
REVENUECAT_WEBHOOK_AUTHORIZATION="Bearer replace-with-random-webhook-token"
REVENUECAT_WEBHOOK_SIGNING_SECRET=replace-with-revenuecat-signing-secret
