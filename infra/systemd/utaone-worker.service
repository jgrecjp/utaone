[Unit]
Description=UtaOne audio analysis worker
After=network-online.target utaone-api.service
Wants=network-online.target

[Service]
Type=simple
User=utaone
Group=utaone
WorkingDirectory=/var/www/utaone
EnvironmentFile=/etc/utaone/api.env
Environment=PYTHONPATH=/var/www/utaone/services/api:/var/www/utaone/services/worker
ExecStart=/var/www/utaone/.venv/bin/python -m utaone_worker --poll-seconds 3
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/utaone

[Install]
WantedBy=multi-user.target
