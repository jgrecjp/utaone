# Public domains. Create DNS A/AAAA records before starting Caddy.
WEB_DOMAIN=utaone.example.com
API_DOMAIN=api.utaone.example.com
ACME_EMAIL=admin@example.com

# Laravel
APP_NAME=UtaOne
APP_ENV=production
APP_KEY=base64:replace-with-php-artisan-key
APP_DEBUG=false
APP_URL=https://utaone.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Internal service authentication
UTAONE_ADMIN_API_TOKEN=replace-with-a-long-random-value

# Gemini (server only)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_AUDIO_MODEL=gemini-3.6-flash

# RevenueCat (server only)
REVENUECAT_ENTITLEMENT_ID=premium
UTAONE_REQUIRE_SUBSCRIPTION=true
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace-with-random-webhook-token
REVENUECAT_WEBHOOK_SIGNING_SECRET=replace-with-revenuecat-signing-secret
